# OpenAI API Key (for Whisper STT and embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key
GOOGLE_API_KEY=your_google_api_key_here

# Kimi (Moonshot AI) API Key
KIMI_API_KEY=your_kimi_api_key_here

# DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenRouter API Key (for DeepSeek, Mistral, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ElevenLabs API Key (for TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Deepgram API Key (for STT)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Application Settings
APP_NAME=Virtuans Voice Agent
APP_ENV=development

# ChromaDB Settings
CHROMA_PERSIST_DIRECTORY=./db/chromadb_store
CHROMA_COLLECTION_NAME=sunmarke_content


